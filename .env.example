# Database backend selection: sqlite | mysql | supabase
DB_BACKEND=sqlite

# SQLite (default, no config needed beyond the file path)
SQLITE_DB_PATH=retinascan_ai.db

# MySQL (only if DB_BACKEND=mysql)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Supabase (only if DB_BACKEND=supabase)
SUPABASE_DB_URL=