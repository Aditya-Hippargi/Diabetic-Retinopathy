# Database backend selection: sqlite | mysql | supabase
DB_BACKEND=supabase
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# SQLite (default, no config needed beyond the file path)
SQLITE_DB_PATH=retinascan_ai.db

# MySQL (only if DB_BACKEND=mysql)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Supabase (only if DB_BACKEND=supabase)
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=